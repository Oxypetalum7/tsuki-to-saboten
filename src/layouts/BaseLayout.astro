---
import "@fontsource/alumni-sans";
import "@fontsource/alumni-sans/700.css";
import "@fontsource/alumni-sans-pinstripe";
import "@fontsource/averia-gruesa-libre";
import "@fontsource/zen-kaku-gothic-new/500.css";
import "@fontsource/zen-kaku-gothic-new/700.css";
import "@fontsource/noto-sans-jp";
import "@fontsource/noto-sans-jp/700.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NavHeader from "../components/NavHeader.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** 記事ページでは "article" を渡す */
  ogType?: "website" | "article";
}

const {
  title,
  description = "月とサボテン — Oxypetalum7's blog。玉石混淆の雑記帳です。",
  ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/ogp.png", Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="月とサボテン"
      href={new URL("/rss.xml", Astro.site)}
    />
    <meta property="og:site_name" content="月とサボテン" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <NavHeader />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
