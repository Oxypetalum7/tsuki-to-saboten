---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import Sidebar from "../components/Sidebar.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="月とサボテン — Oxypetalum7’s blog">
  <section class="hero">
    <h1 class="hero-title">月とサボテン</h1>
    <p class="hero-subtitle">Oxypetalum7’s blog</p>
    <p class="hero-lead">咲いたら書く、玉石混淆の雑記帳。</p>
  </section>
  <div class="page-layout">
    <PostList posts={posts} />
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 48px 20px 0;
  }

  .hero-title {
    font-family: var(--font-jp-round);
    font-size: clamp(32px, 6vw, 44px);
    font-weight: 600;
    letter-spacing: clamp(3px, 0.8vw, 6px);
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: clamp(16px, 2.4vw, 22px);
    letter-spacing: clamp(2px, 0.5vw, 4px);
    color: var(--color-text-soft);
  }

  .hero-lead {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-text-soft);
    margin-top: 8px;
  }
</style>
